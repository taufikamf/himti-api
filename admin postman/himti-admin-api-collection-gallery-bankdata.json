            "url": {
              "raw": "{{baseUrl}}/admin/galleries/:id/restore",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "galleries", ":id", "restore"],
              "variable": [
                {"key": "id", "value": ""}
              ]
            },
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ]
          }
        }
      ]
    },
