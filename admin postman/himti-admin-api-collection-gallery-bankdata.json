              {"key": "Authorization", "value": "Bearer {{token}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated Gallery Title\",\n  \"description\": \"Updated description\",\n  \"isPublished\": true\n}"
            }
          }
        },
        {
          "name": "Soft Delete Gallery",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/admin/galleries/:id/soft",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "galleries", ":id", "soft"],
              "variable": [
                {"key": "id", "value": ""}
              ]
            },
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ]
