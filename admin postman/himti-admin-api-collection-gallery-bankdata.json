              "host": ["{{baseUrl}}"],
              "path": ["admin", "galleries"]
            },
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"New Gallery\",\n  \"description\": \"Gallery description\",\n  \"imageUrl\": \"https://example.com/image.jpg\",\n  \"isPublished\": true\n}"
            }
          }
        },
        {
          "name": "Update Gallery",
          "request": {
            "method": "PATCH",
