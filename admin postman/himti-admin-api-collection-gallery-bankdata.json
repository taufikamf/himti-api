  "item": [
    {
      "name": "Gallery Admin",
      "item": [
        {
          "name": "Get All Galleries",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/admin/galleries?page=1&limit=10&search=",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "galleries"],
              "query": [
                {"key": "page", "value": "1"},
                {"key": "limit", "value": "10"},
                {"key": "search", "value": ""}
              ]
            },
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ]
          }
        },
        {
          "name": "Get Deleted Galleries",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/admin/galleries/deleted?page=1&limit=10&search=",
